{
  "name": "@yhdhappy/dsh-ai-employee",
  "description": "DeepSeek Harness 插件：给每个项目配一个 AI 团队（总顾问、程序员、审核员、情报员），通过任务交接、用户审批和长期协作完成复杂工作",
  "version": "0.1.0",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "src/templates/"
  ],
  "license": "MIT",
  "homepage": "https://github.com/yhdhappy/dsh-ai-employee",
  "repository": {
    "type": "git",
    "url": "https://github.com/yhdhappy/dsh-ai-employee.git"
  },
  "author": "yhdhappy",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"lint: not configured yet\" && exit 0",
    "test": "node --test test/"
  },
  "dependencies": {
    "@deepseek-ai/dsh-storage": "0.1.5-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "pnpm": ">=9"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}